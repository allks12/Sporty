@model Sporty.Services.Groups.CreateGroupInput
@{
    ViewData["Title"] = "Създай група";
}

<section class="sporty-create">
    <h1>Създай група</h1>

    <p class="sporty-create-description">
        Покани хора за следващата игра.
    </p>

    <form class="sporty-create-form" asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <fieldset class="sporty-create-location-choice">
            <legend>Избери място</legend>

            <button type="button"
                    id="choose-venue"
                    class="sporty-create-choice is-active"
                    aria-pressed="true">
                На игрище
            </button>

            <button type="button"
                    id="choose-custom"
                    class="sporty-create-choice"
                    aria-pressed="false">
                Собствена локация
            </button>
        </fieldset>

        <div class="sporty-auth-field">
            <label for="create-sport">Спорт</label>
            <select id="create-sport" asp-for="SportId" asp-items="ViewBag.Sports">
                <option value="">Избери спорт</option>
            </select>
            <span asp-validation-for="SportId" class="text-danger"></span>
        </div>

        <div class="sporty-auth-field">
            <label for="create-title">Заглавие</label>
            <input id="create-title"
                   name="Title"
                   type="text"
                   placeholder="Вечерен мач в Младост" />
        </div>

        <fieldset id="venue-fields" class="sporty-create-fields">
            <legend class="visually-hidden">На игрище</legend>

            <div class="sporty-auth-field">
                <label for="create-venue">Игрище</label>
                <select id="create-venue" name="VenueId">
                    <option value="">Избери игрище</option>
                    <option value="1">
                        Спортна база Младост • Игрище 2
                    </option>
                </select>
            </div>

            <div class="sporty-auth-field">
                <label for="create-slot">Свободен час</label>
                <select id="create-slot" name="TimeSlotId">
                    <option value="">Избери свободен час</option>
                    <option value="1">
                        24 окт. • 18:30–20:00
                    </option>
                </select>
            </div>

            <div class="sporty-auth-field">
                <label for="create-venue-district">Район</label>
                <input id="create-venue-district"
                       type="text"
                       value="Младост, София"
                       readonly />
            </div>
        </fieldset>
        <fieldset id="custom-fields"
                  class="sporty-create-fields"
                  hidden
                  disabled>
            <legend class="visually-hidden">Собствена локация</legend>

            <div class="sporty-auth-field">
                <label for="create-address">Локация / адрес</label>
                <textarea id="create-address"
                          asp-for="CustomLocation"
                          rows="2"
                          placeholder="София, Южен парк • Баскетболно игрище"></textarea>
                <span asp-validation-for="CustomLocation" class="text-danger"></span>
            </div>

            <div class="sporty-auth-field">
                <label for="create-district">Район</label>
                <select id="create-district" asp-for="DistrictId" asp-items="ViewBag.Districts">
                    <option value="">Избери район</option>
                </select>
                <span asp-validation-for="DistrictId" class="text-danger"></span>
            </div>

            <div class="sporty-auth-field">
                <label for="create-environment">Среда</label>
                <select id="create-environment" name="IsOutdoors">
                    <option value="true">На открито</option>
                    <option value="false">На закрито</option>
                </select>
            </div>

            <div class="sporty-auth-field">
                <label for="create-date">Дата</label>
                <input id="create-date"
                       asp-for="Date"
                       type="date" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>

            <div class="sporty-auth-field">
                <label for="create-start">Начален час</label>
                <input id="create-start"
                       asp-for="StartTime"
                       type="time" />
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>

            <div class="sporty-auth-field">
                <label for="create-end">Краен час</label>
                <input id="create-end"
                       name="EndTime"
                       type="time" />
            </div>
        </fieldset>

        <div class="sporty-auth-field">
            <label for="create-min-members">
                Минимален брой участници
            </label>
            <input id="create-min-members"
                   asp-for="MinMembers"
                   type="number"
                   min="2"
                   placeholder="6" />
            <span asp-validation-for="MinMembers" class="text-danger"></span>
        </div>

        <div class="sporty-auth-field">
            <label for="create-max-members">
                Максимален брой участници
            </label>
            <input id="create-max-members"
                   asp-for="MaxMembers"
                   type="number"
                   min="2"
                   placeholder="10" />
            <span asp-validation-for="MaxMembers" class="text-danger"></span>
        </div>

        <button type="submit"
                class="sporty-auth-submit">
            Създай групата
        </button>
    </form>
</section>
@section Scripts {
    <script>
        const venueButton = document.getElementById("choose-venue");
        const customButton = document.getElementById("choose-custom");
        const venueFields = document.getElementById("venue-fields");
        const customFields = document.getElementById("custom-fields");

        function selectLocation(useVenue) {
            venueFields.hidden = !useVenue;
            venueFields.disabled = !useVenue;

            customFields.hidden = useVenue;
            customFields.disabled = useVenue;

            venueButton.classList.toggle("is-active", useVenue);
            customButton.classList.toggle("is-active", !useVenue);

            venueButton.setAttribute("aria-pressed", String(useVenue));
            customButton.setAttribute("aria-pressed", String(!useVenue));
        }

        venueButton.addEventListener("click", () => selectLocation(true));
        customButton.addEventListener("click", () => selectLocation(false));

        // Groups on a venue are not available yet, so the form starts with "own location"
        selectLocation(false);
    </script>
}
