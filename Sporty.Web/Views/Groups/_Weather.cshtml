@using Sporty.Web.Weather
@model WeatherResult

@{
    var culture = System.Globalization.CultureInfo.GetCultureInfo("bg-BG");
}

<section class="sporty-details-weather" aria-label="Прогноза за играта">
    <p class="sporty-details-weather-label">
        ВРЕМЕТО ЗА ИГРАТА
    </p>

    @if (Model.Status == WeatherStatus.Available)
    {
        <div class="sporty-weather-summary">
            @if (!string.IsNullOrWhiteSpace(Model.Icon))
            {
                <img src="@($"https://openweathermap.org/img/wn/{Uri.EscapeDataString(Model.Icon)}@2x.png")"
                     width="80"
                     height="80"
                     alt="" />
            }

            <div>
                <h2>
                    @if (Model.TemperatureCelsius.HasValue)
                    {
                        <span>@Model.TemperatureCelsius.Value.ToString("0.#", culture) °C</span>
                    }
                    else
                    {
                        <span>Температурата е неизвестна</span>
                    }
                </h2>

                <p>
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "Няма описание на времето."
                        : Model.Description)
                </p>
            </div>
        </div>

        <dl class="sporty-weather-metrics">
            <div>
                <dt>Вятър</dt>
                <dd>
                    @if (Model.WindSpeed.HasValue)
                    {
                        <span>@Model.WindSpeed.Value.ToString("0.#", culture) м/с</span>
                    }
                    else
                    {
                        <span>Няма данни</span>
                    }
                </dd>
            </div>

            <div>
                <dt>Вероятност за валеж</dt>
                <dd>
                    @if (Model.PrecipitationProbability.HasValue)
                    {
                        <span>@((Model.PrecipitationProbability.Value * 100).ToString("0", culture))%</span>
                    }
                    else
                    {
                        <span>Няма данни</span>
                    }
                </dd>
            </div>
        </dl>
    }
    else if (Model.Status == WeatherStatus.NotYetAvailable)
    {
        <h2>Прогнозата още не е налична</h2>
        <p>Прогноза се предоставя до 5 дни предварително.</p>
        <p class="sporty-details-muted">
            Провери отново по-близо до датата на играта.
        </p>
    }
    else
    {
        <h2>Прогнозата е недостъпна</h2>
        <p>В момента не можем да заредим прогнозата.</p>
        <p class="sporty-details-muted">
            Опитай отново по-късно.
        </p>
    }
</section>