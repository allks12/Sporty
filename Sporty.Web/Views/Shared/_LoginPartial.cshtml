@using Microsoft.AspNetCore.Identity
@using Sporty.Data.Identity

@inject SignInManager<ApplicationUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    @if (User.IsInRole(AppRoles.Admin))
    {
        <a class="nav-link text-white" asp-area="Admin" asp-controller="Home" asp-action="Index">Админ</a>
    }

    <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout"
          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
        <button id="logout" type="submit" class="nav-link btn btn-link text-white border-0">Изход</button>
    </form>
}
else
{
    <a class="nav-link text-white" id="login" asp-area="Identity" asp-page="/Account/Login">Вход</a>
    <a class="nav-link text-white" id="register" asp-area="Identity" asp-page="/Account/Register">Регистрация</a>
}
