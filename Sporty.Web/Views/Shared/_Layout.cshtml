<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Sporty.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/Sporty.Web.styles.css" asp-append-version="true"/>
</head>
<body>
    <header class="sporty-header">
        <nav class="navbar navbar-expand-sm navbar-dark">
            <div class="container-fluid px-3">
                <a class="navbar-brand text-white"
                   asp-area="" asp-controller="Home"
                   asp-action="Index">
                    <img src="~/images/sporty-logo-clean.svg" alt="" class="sporty-logo" />
                    Sporty
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#sporty-menu"
                        aria-controls="sporty-menu"
                        aria-expanded="false"
                        aria-label="Отвори менюто">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="sporty-menu">
                    <div class="navbar-nav ms-auto align-items-center">
                        <a class="nav-link text-white"
                           asp-area="" asp-controller="Home"
                           asp-action="Index">Начало</a>
                        <a class="nav-link text-white"
                           asp-area=""
                           asp-controller="Groups"
                           asp-action="Index">
                            Търсене
                        </a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="nav-link text-white"
                               asp-area=""
                               asp-controller="Notifications"
                               asp-action="Index">
                                Известия
                            </a>
                        }

                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2026 - Sporty.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>
@if (ViewData["HideMobileNav"] is not true)
{
    <nav class="sporty-mobile-nav" aria-label="Основно мобилно меню">
        <a class="sporty-mobile-nav-item"
           asp-area="" asp-controller="Home"
           asp-action="Index">
            <img src="~/images/nav-home.svg"
                 width="22" height="22" alt="" />
            <span>Начало</span>
        </a>

        <a asp-area=""
           asp-controller="Groups"
           asp-action="Index"
           class="sporty-mobile-nav-item">
            <img src="~/images/nav-search.svg"
                 width="22" height="22" alt="" />
            <span>Търсене</span>
        </a>

        <a asp-area=""
           asp-controller="Groups"
           asp-action="Mine"
           class="sporty-mobile-nav-item">
            <img src="~/images/nav-groups.svg"
                 width="22" height="22" alt="" />
            <span>Моите групи</span>
        </a>

        <a asp-area=""
           asp-controller="Notifications"
           asp-action="Index"
           class="sporty-mobile-nav-item">
            <img src="~/images/nav-notifications.svg"
                 width="22" height="22" alt="" />
            <span>Известия</span>
        </a>
    </nav>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>