@{
    ViewData["Title"] = "Известия";
}

<section class="sporty-notifications">
    <h1>Известия</h1>

    <p class="sporty-notifications-count">
        2 непрочетени
    </p>

    <ul class="sporty-notifications-list">
        <li>
            <article class="sporty-notification is-unread">
                <h2>
                    <span class="sporty-notification-dot"
                          aria-hidden="true"></span>
                    <span class="visually-hidden">Непрочетено: </span>
                    Освободи се място
                </h2>

                <p>
                    Можеш да се включиш във „Волейбол в неделя“.
                </p>

                <span class="sporty-notification-time">
                    Преди 5 мин.
                </span>
            </article>
        </li>

        <li>
            <article class="sporty-notification is-unread">
                <h2>
                    <span class="sporty-notification-dot"
                          aria-hidden="true"></span>
                    <span class="visually-hidden">Непрочетено: </span>
                    Играта е потвърдена
                </h2>

                <p>
                    „Баскетбол след работа“ е потвърдена.
                </p>

                <span class="sporty-notification-time">
                    Преди 20 мин.
                </span>
            </article>
        </li>

        <li>
            <article class="sporty-notification">
                <h2>Нов участник</h2>

                <p>
                    Мария се включи във „Вечерен мач в Младост“.
                </p>

                <span class="sporty-notification-time">
                    Днес, 09:30
                </span>
            </article>
        </li>

        <li>
            <article class="sporty-notification">
                <h2>Групата е отменена</h2>

                <p>
                    „Футбол в петък“ е отменена поради
                    недостатъчен брой участници.
                </p>

                <span class="sporty-notification-time">
                    Вчера, 18:00
                </span>
            </article>
        </li>
    </ul>
</section>