@{
    ViewData["Title"] = "Регистрация";
    ViewData["HideMobileNav"] = true;
}

<section class="sporty-auth">
    <h1>Регистрация</h1>

    <p class="sporty-auth-description">
        Създай профил и намери своята следваща игра.
    </p>

    <form class="sporty-auth-form"
          method="post"
          onsubmit="return false;">

        <div class="sporty-auth-field">
            <label for="register-name">Име</label>
            <input id="register-name"
                   name="Name"
                   type="text"
                   placeholder="Иван Петров"
                   autocomplete="name"
                   required />
        </div>

        <div class="sporty-auth-field">
            <label for="register-email">Имейл</label>
            <input id="register-email"
                   name="Email"
                   type="email"
                   placeholder="ivan@example.com"
                   autocomplete="email"
                   required />
        </div>

        <div class="sporty-auth-field">
            <label for="register-password">Парола</label>
            <input id="register-password"
                   name="Password"
                   type="password"
                   placeholder="••••••••"
                   autocomplete="new-password"
                   required />
        </div>

        <div class="sporty-auth-field">
            <label for="register-confirm-password">Повтори парола</label>
            <input id="register-confirm-password"
                   name="ConfirmPassword"
                   type="password"
                   placeholder="••••••••"
                   autocomplete="new-password"
                   required />
        </div>

        <button type="submit" class="sporty-auth-submit">
            Регистрация
        </button>
    </form>

    <a class="sporty-auth-link"
       asp-controller="Account"
       asp-action="Login">
        Имаш профил? Влез →
    </a>
</section>