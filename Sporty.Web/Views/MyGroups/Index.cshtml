@{
    ViewData["Title"] = "Моите групи";
}

<section class="sporty-my-groups">
    <h1>Моите групи</h1>

    <p class="sporty-my-groups-description">
        Всичките ти игри на едно място.
    </p>

    <a asp-area=""
       asp-controller="Groups"
       asp-action="Create"
       class="sporty-my-groups-create">
        Създай група
    </a>

    <section class="sporty-my-groups-section"
             aria-labelledby="organized-heading">
        <h2 id="organized-heading">Организирам</h2>

        <div class="sporty-games-grid" id="organized-groups">
            <article class="sporty-game-card">
                <div class="sporty-game-card-header">
                    <span class="sporty-game-category">
                        <img src="~/images/sport-football.svg"
                             width="28" height="28" alt="" />
                        ФУТБОЛ
                    </span>

                    <span class="sporty-game-status">Отворена</span>
                </div>

                <h3>Вечерен мач в Младост</h3>

                <p>24 окт. • 18:30–20:00</p>

                <p class="sporty-game-location">
                    Спортна база Младост • София
                </p>

                <p class="sporty-game-limits">
                    Минимум 8 • Максимум 12
                </p>

                <progress class="sporty-game-progress"
                          value="8"
                          max="12"
                          aria-label="8 от 12 участници">
                </progress>

                <div class="sporty-game-card-footer">
                    <span>8 от 12 участници</span>

                    <button type="button"
                            class="sporty-game-details"
                            disabled>
                        Виж групата →
                    </button>
                </div>
            </article>
        </div>
    </section>

    <section class="sporty-my-groups-section"
             aria-labelledby="joined-heading">
        <h2 id="joined-heading">Участвам</h2>

        <div class="sporty-games-grid" id="joined-groups">
            <article class="sporty-game-card sporty-game-card-confirmed">
                <div class="sporty-game-card-header">
                    <span class="sporty-game-category">
                        <img src="~/images/sport-basketball.svg"
                             width="28" height="28" alt="" />
                        БАСКЕТБОЛ
                    </span>

                    <span class="sporty-game-status">Потвърдена</span>
                </div>

                <h3>Баскетбол след работа</h3>

                <p>24 окт. • 19:00–20:00</p>

                <p class="sporty-game-location">
                    Южен парк • София
                </p>

                <p class="sporty-game-limits">
                    Минимум 6 • Максимум 10
                </p>

                <progress class="sporty-game-progress"
                          value="10"
                          max="10"
                          aria-label="10 от 10 участници">
                </progress>

                <div class="sporty-game-card-footer">
                    <span>10 от 10 участници</span>

                    <button type="button"
                            class="sporty-game-details"
                            disabled>
                        Виж групата →
                    </button>
                </div>
            </article>
        </div>
    </section>

    <section class="sporty-my-groups-section"
             aria-labelledby="waiting-heading">
        <h2 id="waiting-heading">В чакащия списък</h2>

        <div class="sporty-games-grid" id="waiting-groups">
            <article class="sporty-game-card sporty-game-card-full">
                <div class="sporty-game-card-header">
                    <span class="sporty-game-category">
                        <img src="~/images/sport-volleyball.svg"
                             width="28" height="28" alt="" />
                        ВОЛЕЙБОЛ
                    </span>
                    <span class="sporty-game-status">Пълна</span>
                </div>

                <h3>Волейбол в неделя</h3>

                <p>25 окт. • 10:00–11:30</p>

                <p class="sporty-game-location">
                    Зала Триадица • София
                </p>

                <p class="sporty-game-limits">
                    Минимум 8 • Максимум 12
                </p>

                <progress class="sporty-game-progress"
                          value="12"
                          max="12"
                          aria-label="12 от 12 участници">
                </progress>

                <div class="sporty-game-card-footer">
                    <span>Позиция 2 в чакащия списък</span>

                    <button type="button"
                            class="sporty-game-details"
                            disabled>
                        Виж групата →
                    </button>
                </div>
            </article>
        </div>
    </section>

    <section class="sporty-my-groups-section"
             aria-labelledby="history-heading">
        <h2 id="history-heading">История</h2>

        <div class="sporty-games-grid" id="history-groups">
            <article class="sporty-game-card sporty-game-card-completed">
                <div class="sporty-game-card-header">
                    <span class="sporty-game-category">
                        <img src="~/images/sport-football.svg"
                             width="28" height="28" alt="" />
                        ФУТБОЛ
                    </span>

                    <span class="sporty-game-status">Приключила</span>
                </div>

                <h3>Неделен футбол</h3>

                <p>18 окт. • 17:00–18:30</p>

                <p class="sporty-game-location">
                    Спортна база Младост • София
                </p>

                <p class="sporty-game-limits">
                    Минимум 8 • Максимум 12
                </p>

                <progress class="sporty-game-progress"
                          value="8"
                          max="12"
                          aria-label="8 от 12 участници">
                </progress>

                <div class="sporty-game-card-footer">
                    <span>8 от 12 участници</span>

                    <button type="button"
                            class="sporty-game-details"
                            disabled>
                        Виж групата →
                    </button>
                </div>
            </article>
        </div>
    </section>
</section>