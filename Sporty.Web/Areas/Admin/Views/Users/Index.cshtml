@model IEnumerable<Sporty.Data.Identity.ApplicationUser>
@{
    ViewData["Title"] = "Потребители";
    ViewData["Breadcrumb"] = "Потребители";
    string search = ViewBag.Search as string ?? string.Empty;
    string? currentUserId = ViewBag.CurrentUserId as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h2 fw-bold mb-1">Потребители</h1>
        <p class="text-muted mb-0">Търси потребители и управлявай достъпа им.</p>
    </div>
</div>

@if (TempData["Error"] is string errorMsg)
{
    <div class="alert alert-warning">@errorMsg</div>
}

<div class="admin-card p-4 mb-4">
    <form method="get" asp-area="Admin" asp-controller="Users" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-md-9">
            <label for="userSearch" class="form-label fw-semibold">Търсене</label>
            <input type="text" id="userSearch" name="search" value="@search"
                   class="form-control" placeholder="Име или имейл..." />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-sporty-primary w-100">Търси</button>
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-outline-sporty">
                    Изчисти
                </a>
            }
        </div>
    </form>
</div>

@if (!Model.Any())
{
    <div class="admin-card p-4 text-muted">
        Няма намерени потребители.
    </div>
}
else
{
    <div class="admin-card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Име</th>
                        <th>Имейл</th>
                        <th>Достъп</th>
                        <th class="text-end pe-4">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var isBlocked = user.LockoutEnd.HasValue && user.LockoutEnd.Value > DateTimeOffset.UtcNow;
                        var isSelf = user.Id == currentUserId;
                        <tr>
                            <td class="ps-4 fw-semibold">
                                @(string.IsNullOrWhiteSpace(user.Name) ? (user.UserName ?? "Потребител") : user.Name)
                            </td>
                            <td>@user.Email</td>
                            <td>
                                @if (isBlocked)
                                {
                                    <span class="badge rounded-pill text-bg-danger">Блокиран</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill text-bg-success">Активен</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-2">
                                    @if (!isSelf)
                                    {
                                        <form asp-area="Admin" asp-controller="Users" asp-action="ToggleBlock"
                                              asp-route-id="@user.Id" asp-route-search="@search"
                                              method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            @if (isBlocked)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-sporty">
                                                    Отблокирай
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-sporty">
                                                    Блокирай
                                                </button>
                                            }
                                        </form>

                                        <form asp-area="Admin" asp-controller="Users" asp-action="Delete"
                                              asp-route-id="@user.Id" asp-route-search="@search"
                                              method="post" class="d-inline"
                                              onsubmit="return confirm('Сигурни ли сте, че искате да изтриете този потребител?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger">Изтрий</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Текущ админ</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}