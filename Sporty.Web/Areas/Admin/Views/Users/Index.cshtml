@model List<Sporty.Data.Identity.ApplicationUser>
@inject Microsoft.AspNetCore.Identity.UserManager<Sporty.Data.Identity.ApplicationUser> UserManager
@{
    ViewData["Title"] = "Потребители";
    var currentUserId = UserManager.GetUserId(User);
}

<h1 class="h3 my-3">Потребители</h1>

<table class="table align-middle">
    <thead>
    <tr>
        <th>Име</th>
        <th>Имейл</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var user in Model)
    {
        <tr>
            <td>@user.Name</td>
            <td>@user.Email</td>
            <td class="text-end">
                @if (user.Id != currentUserId)
                {
                    <form asp-action="Delete" asp-route-id="@user.Id" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Изтрий</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
