@model List<Sporty.Data.Entities.Group>
@{
    ViewData["Title"] = "Групи";
}

<h1 class="h3 my-3">Групи</h1>

<table class="table align-middle">
    <thead>
    <tr>
        <th>Начало</th>
        <th>Спорт</th>
        <th>Място</th>
        <th>Организатор</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var group in Model)
    {
        <tr>
            <td>@group.StartAt.ToString("dd.MM.yyyy HH:mm")</td>
            <td>@group.Sport.SportName</td>
            <td>@group.CustomLocation</td>
            <td>@group.Organizer?.Name</td>
            <td class="text-end">
                <form asp-action="Delete" asp-route-id="@group.GroupId" method="post">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Изтрий</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
