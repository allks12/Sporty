@{
    ViewData["Title"] = "Административен панел";
    ViewData["Breadcrumb"] = "Начало";
}

<div class="mb-4">
    <h1 class="h2 fw-bold mb-1">Административен панел</h1>
    <p class="text-muted mb-0">Избери раздел за управление.</p>
</div>

<div class="d-flex flex-column gap-3">
    <a asp-area="Admin" asp-controller="Users" asp-action="Index"
       class="admin-card p-4 text-decoration-none text-dark d-flex justify-content-between align-items-center">
        <div>
            <div class="fw-bold fs-5 mb-1">Потребители</div>
            <div class="text-muted">Списък и управление на профили.</div>
        </div>
        <span class="fs-4 text-muted">→</span>
    </a>

    <a asp-area="Admin" asp-controller="Venues" asp-action="Index"
       class="admin-card p-4 text-decoration-none text-dark d-flex justify-content-between align-items-center">
        <div>
            <div class="fw-bold fs-5 mb-1">Игрища</div>
            <div class="text-muted">Добавяне и редакция на игрища.</div>
        </div>
        <span class="fs-4 text-muted">→</span>
    </a>

    <a asp-area="Admin" asp-controller="TimeSlots" asp-action="Index"
       class="admin-card p-4 text-decoration-none text-dark d-flex justify-content-between align-items-center">
        <div>
            <div class="fw-bold fs-5 mb-1">Свободни часове</div>
            <div class="text-muted">Преглед и добавяне на свободни часове.</div>
        </div>
        <span class="fs-4 text-muted">→</span>
    </a>

    <a asp-area="Admin" asp-controller="Groups" asp-action="Index"
       class="admin-card p-4 text-decoration-none text-dark d-flex justify-content-between align-items-center">
        <div>
            <div class="fw-bold fs-5 mb-1">Групи</div>
            <div class="text-muted">Преглед, отмяна и проверка на групи.</div>
        </div>
        <span class="fs-4 text-muted">→</span>
    </a>
</div>