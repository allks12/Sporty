@model IEnumerable<Sporty.Data.Entities.TimeSlot>
@{
    ViewData["Title"] = "Свободни часове";
    ViewData["Breadcrumb"] = "Свободни часове";
    int? selectedVenueId = ViewBag.SelectedVenueId as int?;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h2 fw-bold mb-1">Свободни часове</h1>
        <p class="text-muted mb-0">Часовете на избраното игрище.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="Admin" asp-controller="Venues" asp-action="Index" class="btn btn-outline-sporty px-3 py-2">
            Към игрищата
        </a>
        <a asp-area="Admin" asp-controller="TimeSlots" asp-action="Create" asp-route-venueId="@selectedVenueId"
           class="btn btn-sporty-primary px-3 py-2">
            + Добави час
        </a>
    </div>
</div>

<div class="admin-card p-4 mb-4">
    <form method="get" asp-area="Admin" asp-controller="TimeSlots" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-md-8">
            <label for="venueSelect" class="form-label fw-semibold">Игрище</label>
            <select id="venueSelect" name="venueId" asp-items="ViewBag.Venues"
                    class="form-select" onchange="this.form.submit();"></select>
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-outline-sporty w-100">Покажи часовете</button>
        </div>
    </form>
</div>

@if (!Model.Any())
{
    <div class="admin-card p-4 text-muted">
        Няма добавени часове за избраното игрище.
    </div>
}
else
{
    <div class="admin-card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Дата</th>
                        <th>Начало</th>
                        <th>Край</th>
                        <th>Наличност</th>
                        <th class="text-end pe-4">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slot in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@slot.StartAt.ToString("dd.MM.yyyy")</td>
                            <td>@slot.StartAt.ToString("HH:mm")</td>
                            <td>@slot.EndAt.ToString("HH:mm")</td>
                            <td>
                                @if (slot.IsReserved)
                                {
                                    <span class="badge rounded-pill text-bg-warning">Зает от група</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill text-bg-success">Свободен</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <form asp-area="Admin" asp-controller="TimeSlots" asp-action="Delete"
                                      asp-route-id="@slot.TimeSlotId" asp-route-venueId="@slot.VenueId"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('Сигурни ли сте, че искате да изтриете този час?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">Изтрий</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}